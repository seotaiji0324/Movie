# Snowflake account identifier from Admin > Accounts or your connection profile.
# Never commit a real .env file. Quote passwords that contain # characters.
SNOWFLAKE_CONNECTION_NAME=
SNOWFLAKE_ACCOUNT=organization-account
SNOWFLAKE_USERNAME=username
SNOWFLAKE_PASSWORD="replace-me"
SNOWFLAKE_DATABASE=movieDB
SNOWFLAKE_SCHEMA=PUBLIC
# Optional when the Snowflake user has a default warehouse and role.
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
MAX_VIDEO_BYTES=52428800
